generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  OUTLET_MANAGER
  HEAD_CHEF
  VIEWER
}

enum OutletType {
  OUTLET
  PREP_KITCHEN
  ADMIN
}

enum ApiType {
  SALES
  PURCHASE
  INVENTORY
  TRANSFER
}

enum SyncType {
  SALES
  INVENTORY
  PURCHASE
  HISTORICAL
  TRANSFER
}

enum TriggerType {
  CRON
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryTransactionType {
  OPENING
  PURCHASE
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum DataSource {
  PETPOOJA
  STUB
  MANUAL
}

enum ClassAItemType {
  ITEM
  CATEGORY
}

enum RecipeTriggerType {
  ITEM_NAMES
  NAME_CONTAINS
}

enum WastageReason {
  EXPIRED
  SPOILED
  PREP_ERROR
  DROPPED_DAMAGED
  OTHER
}

enum WebhookOutcome {
  SUCCESS
  REJECTED
}

// ---------- Core entities ----------

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  outletId     String?
  outlet       Outlet?   @relation(fields: [outletId], references: [id])
  // Access scope, coarser than outletId: null means every brand. When outletId is set this
  // is derived from that outlet, so the two can never disagree. Roles that require an
  // outlet (HEAD_CHEF/OUTLET_MANAGER) stay scoped by outletId, not by this.
  brand        String?
  // Pages this user may reach beyond what their role allows. Additive only — today the sole
  // grantable value is 'sales-forecast', an array so a second page needs no migration.
  pageGrants   String[] @default([])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  syncLogs             SyncLog[]
  notificationSettings NotificationSetting?
  wastageEntries       WastageEntry[]
  soldOutEntries       SoldOutEntry[]
  predictionImportLogs PredictionImportLog[]
}

model Outlet {
  id                 String     @id @default(cuid())
  name               String
  brand              String
  rid                String     @unique
  outletType         OutletType @default(OUTLET)
  city               String?
  address            String?
  isActive           Boolean    @default(true)
  salesSyncCode      String?
  inventorySyncCode  String?
  lowStockAlertEnabled Boolean  @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  users                 User[]
  sales                 Sale[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  syncLogs              SyncLog[]
  wastageEntries        WastageEntry[]
  predictedSales        PredictedSale[]
  soldOutEntries        SoldOutEntry[]
  purchaseOrderWebhookLogs PurchaseOrderWebhookLog[]
}

model Sale {
  id              String   @id @default(cuid())
  outletId        String
  outlet          Outlet   @relation(fields: [outletId], references: [id])
  invoiceNumber   String
  petpoojaOrderId String?
  orderDateTime   DateTime
  orderDate       DateTime @db.Date
  customerName    String?
  customerPhone   String?
  grossAmount     Decimal  @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  paymentMode     String
  orderType       String?
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items SaleItem[]

  @@unique([outletId, invoiceNumber])
  @@index([outletId, orderDate])
  @@index([orderDate])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemName   String
  category   String?
  quantity   Decimal  @db.Decimal(10, 2)
  price      Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([itemName])
  @@index([category])
}

model Inventory {
  id                String     @id @default(cuid())
  outletId          String
  outlet            Outlet     @relation(fields: [outletId], references: [id])
  itemName          String
  category          String?
  unit              String?
  store             String?
  openingStock      Decimal    @default(0) @db.Decimal(12, 2)
  // True while openingStock is still machine-derived (previous day's closing + that
  // day's PO) and should keep tracking those inputs. Cleared the moment a human edits
  // Opening, after which the value is theirs and never recomputed.
  openingAutoFilled Boolean    @default(false)
  purchasedQty      Decimal    @default(0) @db.Decimal(12, 2)
  consumedQty       Decimal    @default(0) @db.Decimal(12, 2)
  closingStock      Decimal    @default(0) @db.Decimal(12, 2)
  currentStock      Decimal    @default(0) @db.Decimal(12, 2)
  unitValue         Decimal    @default(0) @db.Decimal(12, 2)
  stockValue        Decimal    @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal?   @db.Decimal(12, 2)
  isLowStock        Boolean    @default(false)
  stockDate         DateTime   @db.Date
  source            DataSource @default(STUB)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([outletId, itemName, stockDate])
  @@index([outletId, stockDate])
}

model InventoryTransaction {
  id                  String                    @id @default(cuid())
  outletId            String
  outlet              Outlet                    @relation(fields: [outletId], references: [id])
  itemName            String
  transactionType     InventoryTransactionType
  quantity            Decimal                   @db.Decimal(12, 2)
  unit                String?
  referenceType       String?
  referenceId         String?
  sourceOutletId      String?
  destinationOutletId String?
  transactionDate     DateTime
  rawPayload          Json?
  source              DataSource                @default(STUB)
  createdAt           DateTime                  @default(now())

  @@index([outletId, transactionDate])
  @@index([itemName])
}

model Vendor {
  id                String   @id @default(cuid())
  name              String
  petpoojaSupplierId String? @unique
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  poNumber           String
  petpoojaPurchaseId String?
  outletId           String
  outlet             Outlet              @relation(fields: [outletId], references: [id])
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  invoiceNumber      String?
  status             PurchaseOrderStatus @default(PENDING)
  totalAmount        Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @default(0) @db.Decimal(12, 2)
  orderDate          DateTime
  expectedDate       DateTime?
  receivedDate       DateTime?
  petpoojaCreatedAt  DateTime?
  rawPayload         Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@unique([outletId, poNumber])
  @@unique([outletId, petpoojaPurchaseId])
  @@index([outletId, orderDate])
  // Reconciliation attributes POs by expectedDate and queries it twice per page load.
  @@index([outletId, expectedDate])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName        String
  quantity        Decimal       @db.Decimal(12, 2)
  unit            String?
  rate            Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  cgst            Decimal       @default(0) @db.Decimal(12, 2)
  sgst            Decimal       @default(0) @db.Decimal(12, 2)
  igst            Decimal       @default(0) @db.Decimal(12, 2)
  cess            Decimal       @default(0) @db.Decimal(12, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 2)
  pendingQty      Decimal       @default(0) @db.Decimal(12, 2)
}

// Audit trail of every inbound PO webhook call from Petpooja, success or rejected.
// purchaseOrderId is deliberately a plain string, not a relation: PurchaseOrder rows
// are pruned after 7 days by historicalSync.service.ts, and a hard FK would eventually
// fail once a log outlives the row it produced. The log must survive independently.
model PurchaseOrderWebhookLog {
  id                 String               @id @default(cuid())
  receivedAt         DateTime             @default(now())
  outletId           String?
  outlet             Outlet?              @relation(fields: [outletId], references: [id])
  petpoojaPurchaseId String?
  poNumber           String?
  menuSharingCode    String?
  outcome            WebhookOutcome
  httpStatusCode     Int
  failureReason      String?
  status             PurchaseOrderStatus?
  writeResult        String?
  purchaseOrderId    String?
  rawPayload         Json

  @@index([outletId, receivedAt])
  @@index([outcome, receivedAt])
  @@index([petpoojaPurchaseId])
}

model SyncLog {
  id                String      @id @default(cuid())
  syncType          SyncType
  triggerType       TriggerType
  outletId          String?
  outlet            Outlet?     @relation(fields: [outletId], references: [id])
  status            SyncStatus
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  recordsFetched    Int         @default(0)
  recordsCreated    Int         @default(0)
  recordsUpdated    Int         @default(0)
  recordsFailed     Int         @default(0)
  errorMessage      String?
  triggeredByUserId String?
  triggeredByUser   User?       @relation(fields: [triggeredByUserId], references: [id])
  createdAt         DateTime    @default(now())

  @@index([syncType, outletId, createdAt])
}

model PetpoojaApiConfig {
  id                    String    @id @default(cuid())
  apiType               ApiType   @unique
  appKeyEncrypted       String?
  appSecretEncrypted    String?
  accessTokenEncrypted  String?
  cookieEncrypted       String?
  isConfigured          Boolean   @default(false)
  lastVerifiedAt        DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SyncSchedule {
  id              String   @id @default(cuid())
  syncType        SyncType @unique
  cronExpression  String
  isEnabled       Boolean  @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NotificationSetting {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  lowStockAlerts      Boolean  @default(true)
  syncFailureAlerts   Boolean  @default(true)
  dailySummaryEmail   Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model ClassAItem {
  id        String         @id @default(cuid())
  brand     String
  type      ClassAItemType
  value     String
  // Purchase-order names this item also counts. Sold names and purchased names never
  // overlap in Petpooja ("Coke" is sold, "Coke 300 Ml" is purchased; "Saucy Momos" is
  // sold, "Soucy Momos" is purchased), so `value` matches sales and these match POs.
  purchaseAliases String[]  @default([])
  createdAt DateTime       @default(now())

  @@unique([brand, type, value])
}

model PredictedSale {
  id           String               @id @default(cuid())
  outletId     String
  outlet       Outlet               @relation(fields: [outletId], references: [id])
  itemName     String
  stockDate    DateTime             @db.Date
  predictedQty Decimal              @db.Decimal(10, 2)
  source       String
  importLogId  String?
  importLog    PredictionImportLog? @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([outletId, itemName, stockDate])
  @@index([outletId, stockDate])
}

// One row per uploaded forecast workbook (Settings > Sales Forecast). Mirrors
// SyncLog's RUNNING -> SUCCESS/PARTIAL/FAILED shape (see syncRunner.service.ts) so
// the "Recent Imports" UI can reuse the same status-badge convention as "Recent Sync
// Runs" rather than inventing a parallel one.
model PredictionImportLog {
  id                String          @id @default(cuid())
  fileName          String
  status            SyncStatus
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  rowsCreated       Int             @default(0)
  rowsUpdated       Int             @default(0)
  sheetsProcessed   Int             @default(0)
  sheetsSkipped     Json?
  errorMessage      String?
  triggeredByUserId String?
  triggeredByUser   User?           @relation(fields: [triggeredByUserId], references: [id])
  createdAt         DateTime        @default(now())

  predictedSales PredictedSale[]
}

model SoldOutEntry {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  itemName     String
  stockDate    DateTime @db.Date
  missedQty    Int
  reportedById String?
  reportedBy   User?    @relation(fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([outletId, itemName, stockDate])
  @@index([outletId, stockDate])
}

model WastageEntry {
  id           String        @id @default(cuid())
  outletId     String
  outlet       Outlet        @relation(fields: [outletId], references: [id])
  itemName     String
  category     String?
  quantity     Decimal       @db.Decimal(10, 2)
  unit         String?
  reason       WastageReason
  notes        String?
  reportedById String?
  reportedBy   User?         @relation(fields: [reportedById], references: [id])
  wastageDate  DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@index([outletId, wastageDate])
}

/**
 * A "recipe" rule for a derived Reconciliation ingredient — e.g. "Big Dough"
 * isn't a real sold item, its Sales figure is the sum of several real dishes'
 * sales (every 15" pizza, dough balls, etc). One ingredientName can have
 * multiple rules (unioned together). The ingredientName must also exist as a
 * ClassAItem(type: ITEM) for that brand to actually show up as a row.
 */
model ReconciliationRecipe {
  id             String            @id @default(cuid())
  brand          String
  ingredientName String
  triggerType    RecipeTriggerType
  triggerValues  String[]
  qtyPerMatch    Decimal           @default(1) @db.Decimal(10, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([brand, ingredientName])
}
